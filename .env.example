# Copy to .env and fill in. Never commit .env.
# HCX (HyperCLOVA X, backend: hcx). CLOVA Studio API key (starts with nv-). URL and model are in configs/model.yaml.
HCX_API_KEY=
# KOSIS OpenAPI
KOSIS_API_KEY=
# ChromaDB (docker compose service `chroma`, T2-23). Host-side address for notebooks, scripts and tests.
# Inside compose the backend uses chroma:8000 (set in docker-compose.yml). Change CHROMA_PORT if 8001 is taken.
CHROMA_HOST=localhost
CHROMA_PORT=8001
# Jaeger tracing for eval runs (T2-15). Start with `docker compose --profile obs up -d jaeger`; unset = no export.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# JAEGER_UI_URL=http://localhost:16686
# Staged search (T2-06, T2-07). Read from the shell environment by backend/app/config.py (T2-41 S4: the module and
# the backend no longer read this file; docker compose passes it through env_file). Weights are not in git: put
# them under data/models/.
# CHROMA_COLLECTION=kosis_a_bgeft_<version>   # built by: python -m kosis_rag.index --model bge-m3-ft
# EMBED_CKPT=data/models/bge-m3-seen-e2.pt
# RERANK_CKPT=data/models/bge-reranker-unseen-e2.pt   # empty = no stage 1
# RERANK_MODE=blend   # blend | score
# STAGE2=clova        # clova | none (uses HCX_API_KEY)
# COND_FILTER=on      # on | off: T2-14 conditions before the hybrid
# TEXT_FORMAT=n2-L60  # optional check; the collection records its table text (kosis_rag.text: n2-L60; n3-L60 deprecated)
# OpenAI (gpt-4o-mini): T2-39 question generation (python -m kosis_rag.hq.build) and STAGE2 gpt. Never commit the key.
OPENAI_API_KEY=
# T2-39 question index (reverse HyDE, kosis_rag.hq). Read by the LangGraph search only (graph:<preset>).
# HQ_BUILD=hq-<prompt8>-<tables8>-<model>-f30-k2   # build id printed by kosis_rag.hq.build; empty = off
# HQ_WEIGHT=1.0                          # RRF weight of the question lists
# HQ_BM25=off                            # on: also BM25 over each table's questions
